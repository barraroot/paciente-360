APP_NAME=Paciente360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# --- Hashing (argon2id default — Princípio VII) ---
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
# Bcrypt fallback (se argon2 indisponível) — mínimo 12 rounds
BCRYPT_ROUNDS=12

# --- Multi-tenancy (Princípio II) ---
# Sufixo de domínio para resolução de tenant por subdomínio.
# Dev/CI: lvh.me (resolve `*.lvh.me` em 127.0.0.1)
# Prod:   crm.com.br
TENANCY_SUBDOMAIN_SUFFIX=lvh.me

# --- Sanctum SPA stateful (T050 — Princípio VII) ---
# Domínios que recebem cookies de sessão. Em dev: subdomínios lvh.me.
# Em prod: subdomínios crm.com.br.
SANCTUM_STATEFUL_DOMAINS=*.lvh.me,lvh.me
SESSION_DOMAIN=.lvh.me

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=paciente360
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.lvh.me

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@paciente360.test"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# --- Laravel Reverb (WebSocket) ---
REVERB_APP_ID=paciente360
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Horizon ---
HORIZON_PREFIX=horizon:paciente360
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# --- Billing / Stripe (Princípio VII + FR-013/014/019) ---
# Credenciais ficam vazias no .env.example (cada ambiente injeta as suas).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=brl
# Política de cobrança (FR-014):
#   3 tentativas → Inadimplente; 7 dias de carência; +30 dias = 37 elegível à suspensão.
BILLING_PAYMENT_RETRIES=3
BILLING_GRACE_DAYS=7
BILLING_SUSPENSION_ELIGIBLE_DAYS=37
# Hard cap default IA (centavos BRL). (null) = sem teto (FR-019).
BILLING_HARD_CAP_DEFAULT=(null)
BILLING_WEBHOOK_PATH=stripe/webhook
BILLING_WEBHOOK_TOLERANCE=300

# --- Auditoria (Princípio I — LGPD, FR-038) ---
# Tier hot: 730 dias (2 anos). Tier cold: até 1825 dias (5 anos).
# Deleção física aos 5 anos (LGPD Art. 16 — minimização).
AUDIT_HOT_DAYS=730
AUDIT_COLD_DAYS=1825
AUDIT_DELETE_AFTER_DAYS=1825
AUDIT_ARCHIVE_BATCH_SIZE=1000
# Cron: dia 1 do mês — archive 03:00, delete 04:00 (archive antes de delete).
AUDIT_SCHEDULE_ARCHIVE="0 3 1 * *"
AUDIT_SCHEDULE_DELETE="0 4 1 * *"

# --- Telescope (Princípio V + VII) ---
# Default false — só ligar em local/staging. Em produção precisa permanecer
# vazio/false: mesmo se TELESCOPE_ENABLED=true vazar, o
# App\Providers\TelescopeServiceProvider::register() bloqueia via
# app()->environment(['local','staging']) (defesa em profundidade).
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
# Watchers sensíveis (LGPD) — manter false em staging por padrão.
TELESCOPE_MAIL_WATCHER=false

# --- Sentry (Princípio V — Observabilidade) ---
# DSN vazio = cliente inerte (sem dispatch). Em produção/staging, injetar
# via secret manager. Tag `tenant.id` e `user.id` populadas em runtime
# pelo AppServiceProvider quando o pacote estiver bound.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
# Performance/APM: opt-in. Default null/0 = desativado.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
# LGPD — manter false. PII (IP, headers, body) só com opt-in + DPIA.
SENTRY_SEND_DEFAULT_PII=false
# Breadcrumbs: SQL bindings desabilitado (LGPD).
SENTRY_BREADCRUMBS_SQL_BINDINGS_ENABLED=false

# --- Fase 3: Omnichannel Inbox ---

# Twilio (WhatsApp Business via Programmable Messaging — NC-1/Q1)
# Sandbox WhatsApp: +14155238886 (usar em dev/test antes de aprovação)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_DEFAULT=whatsapp:+14155238886
TWILIO_CONTENT_API_VERSION=2010-04-01

# Meta / Facebook (Instagram Direct via Graph API direta — Twilio não suporta IG DM)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# Evolution API v2 (WhatsApp NÃO oficial via Baileys — feature 014).
# Auto-hospedado: container `evolution-api` (profile `evolution`). A app fala
# com ele em http://evolution-api:8080 (rede sail). EVOLUTION_API_KEY é a
# AUTHENTICATION_API_KEY global do servidor Evolution (gere um segredo forte).
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_HTTP_TIMEOUT_SECONDS=15
# SERVER_URL público do Evolution (exibido em QR/callbacks). Local: http://localhost:8085
EVOLUTION_SERVER_URL=http://localhost:8085
FORWARD_EVOLUTION_PORT=8085

# Widget público (bundle JS embutível em sites de terceiros)
WIDGET_PUBLIC_DOMAIN=widget.lvh.me
WIDGET_PUBLIC_DOMAIN_DEV=widget.lvh.me
WIDGET_PUBLIC_PROTOCOL=http

# S3 — disk 'media' dedicado (LGPD: bucket isolado, URLs pré-assinadas 24h)
# Dev: MinIO via Docker (container paciente-360-minio-1)
# Prod: AWS S3 ou Cloudflare R2 — injetar via secret manager
FILESYSTEM_DISK_MEDIA=s3
AWS_BUCKET_MEDIA=paciente360-media
AWS_REGION_MEDIA=us-east-1
AWS_ACCESS_KEY_ID_MEDIA=sail
AWS_SECRET_ACCESS_KEY_MEDIA=password
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT_MEDIA=http://minio:9000

# ──────────────────────────────────────────────────────────────
# Fase 4 — Token Auth Migration (Cookie → Bearer)
# ──────────────────────────────────────────────────────────────

# Sanctum Personal Access Tokens
# Prefixo nos tokens emitidos — facilita secret scanning em repositórios.
SANCTUM_TOKEN_PREFIX=paciente360_
# SANCTUM_EXPIRATION=43200  # 30d em min (default — configurado em config/sanctum.php)

# CORS — origens autorizadas a chamar a API tenant.
# Dev local: Vite HMR (5173) + alternativo (3000) + subdomínios lvh.me.
# Prod: apenas os domínios do produto (app.crm.com.br).
# Múltiplos valores separados por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://clinica-alfa.lvh.me,http://clinica-beta.lvh.me

# Filament admin domain isolation (FR-018)
# Em prod: SESSION_DOMAIN=crm.com.br para isolar cookie Filament de app.crm.com.br.
# Em dev: SESSION_DOMAIN=null (Laravel usa exact host — sem compartilhamento de cookie).
# ATENÇÃO: manter sincronizado com SANCTUM_STATEFUL_DOMAINS acima.
SESSION_DOMAIN=null

# Domínios do produto (referência prod)
FILAMENT_DOMAIN=crm.com.br
APP_TENANT_DOMAIN=app.crm.com.br
API_TENANT_DOMAIN=api.crm.com.br

# Frontend Vite — base URL da API (importante em build CDN-friendly para evitar CORS em dev)
VITE_API_BASE_URL=http://api.lvh.me/api/v1

# ──────────────────────────────────────────────────────────────
# Fase 5 — Agendamento de Consultas (Google Calendar Sync)
# ──────────────────────────────────────────────────────────────

# Google OAuth credentials (criar em Google Cloud Console — ver quickstart.md §2)
# Production: registrar em secret manager; nunca commitar valores reais.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Callback público — registrar exatamente este URI no OAuth Client do GCP.
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/api/v1/agenda/calendar-sync/google/callback"
# Base URL pública para watch channel webhook (Google só aceita HTTPS público válido em prod).
GOOGLE_CALENDAR_WEBHOOK_BASE_URL="${APP_URL}/webhooks/google-calendar"

# Janela de eventos sincronizados (clarify nº 10 — rolling window). Default 60 dias futuros.
AGENDA_CALENDAR_SYNC_WINDOW_DAYS=60

# Cron renova watch channels que expiram nas próximas N horas (Google TTL ~7d).
AGENDA_WATCH_CHANNEL_RENEW_HOURS=48

# CSP — hosts Google a permitir em connect-src (Princípio VII / Fase 5 T004).
# Override apenas se Google migrar endpoints; default cobre OAuth + Token + Calendar API.
CSP_GOOGLE_HOSTS="https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com"

# ──────────────────────────────────────────────────────────────
# IA Matricial (Fase 015) — provedores laravel/ai
# ──────────────────────────────────────────────────────────────

# Credenciais GLOBAIS da plataforma (não por tenant). Nunca commitar valores reais.
# OpenAI: obrigatório para modelos GPT do catálogo E para embeddings/RAG
# (config/ai.php: default_for_embeddings = openai, text-embedding-3-small).
OPENAI_API_KEY=
# Anthropic: necessário para os modelos Claude do catálogo.
ANTHROPIC_API_KEY=

# Provedor/modelo default do atendimento (override do catálogo ai_models).
# Deixe em branco para usar os defaults de config/ai.php (anthropic / claude-haiku-4-5).
AI_DEFAULT_PROVIDER=
AI_MATRICIAL_DEFAULT_MODEL=

# Humanização da conversa (feature 017): histórico mínimo, ferramentas e work context.
AI_HISTORY_WINDOW_MESSAGES=6
AI_HISTORY_INPUT_TOKEN_CEILING=6000
AI_SUMMARY_MAX_TOKENS=400
AI_TOOLS_ENABLED=true
AI_TOOLS_MAX_ROUND_TRIPS=3
AI_WORK_CONTEXT_MAX_QUESTIONS=8
AI_WORK_CONTEXT_FREE_FORM_MAX_CHARS=4000
AI_PROMPT_CACHING=true

# --- Feature 018 — Conversa Reativa, Multimodal e Auto-Curadoria do Kanban via IA ---

# Coalescência híbrida (US1)
AI_COALESCE_PASSIVE_DEBOUNCE_S=4
AI_COALESCE_MAX_TURN_S=30
AI_COALESCE_MAX_REPROCESSES=3

# Servidor MCP local (US7) — substitui laravel/ai como caminho de tools quando ativo
AI_TOOLS_VIA_MCP=false
MCP_LOCAL_URL=http://mcp-server:8090
MCP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
MCP_CIRCUIT_BREAKER_FAILURE_WINDOW_S=30
MCP_CIRCUIT_BREAKER_INITIAL_COOLDOWN_S=60
MCP_CIRCUIT_BREAKER_MAX_COOLDOWN_S=600

# STT — Speech-to-Text (US4) — OpenAI Whisper default
MESSAGING_STT_PROVIDER=openai_whisper
MESSAGING_STT_OPENAI_API_KEY=
MESSAGING_STT_TIMEOUT_S=15
MESSAGING_STT_MAX_DURATION_S=120

# TTS — Text-to-Speech (US5) — ElevenLabs default
MESSAGING_TTS_PROVIDER=elevenlabs
MESSAGING_TTS_ELEVENLABS_API_KEY=
MESSAGING_TTS_MAX_TEXT_LENGTH=2000
MESSAGING_TTS_ENABLED=true

# Rate limit anti-abuso (Polish T200-T207) — 2 camadas
MESSAGING_RATE_PER_CONVERSATION=30
MESSAGING_RATE_PER_IDENTIFIER=100
MESSAGING_RATE_WINDOW_MINUTES=10
MESSAGING_COOLDOWN_MINUTES=15
