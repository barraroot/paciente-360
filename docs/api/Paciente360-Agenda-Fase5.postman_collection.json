            }
          }
        },
        {
          "name": "POST reverte marcação (48h)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}/reverter-comparecimento",
              "host": ["{{base_url}}"],
