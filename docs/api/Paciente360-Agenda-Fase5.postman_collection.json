          }
        }
      ]
    },
    {
      "name": "US-6.5 — Cancelamento via chat",
      "description": "Política de prazo tenant→type override (clarify nº 3 — bloqueia + escala para inbox).",
      "item": [
        {
          "name": "POST cancela (paciente — dentro do prazo)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}/cancelar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas", "{{appointment_id}}", "cancelar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
