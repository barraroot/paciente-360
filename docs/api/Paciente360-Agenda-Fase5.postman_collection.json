    {
      "name": "US-6.3 — Appointments (CRUD + reagendar)",
      "description": "Criação de consulta com gate atômico de race (FR-011a / SC-008) + reagendamento com idempotency (clarify nº 7).",
      "item": [
        {
          "name": "GET lista consultas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/consultas?professional_id={{professional_id}}&status[]=scheduled&status[]=confirmed&from=2026-06-01&to=2026-06-30&page=1&per_page=50",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas"],
              "query": [
                { "key": "professional_id", "value": "{{professional_id}}" },
                { "key": "status[]", "value": "scheduled" },
                { "key": "status[]", "value": "confirmed" },
                { "key": "from", "value": "2026-06-01" },
                { "key": "to", "value": "2026-06-30" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "POST cria consulta (painel)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{$randomUUID}}\",\n  \"paciente_id\": {{paciente_id}},\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}},\n  \"starts_at\": \"{{slot_starts_at}}\",\n  \"channel_origin\": \"painel\",\n  \"notify_patient\": true\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if ([200, 201].includes(pm.response.code)) {",
                    "  pm.collectionVariables.set('appointment_id', pm.response.json().data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "POST cria consulta (IA Matricial)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{$randomUUID}}\",\n  \"paciente_id\": {{paciente_id}},\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}},\n  \"starts_at\": \"{{slot_starts_at}}\",\n  \"channel_origin\": \"ia\",\n  \"reservation_id\": {{slot_reservation_id}}\n}"
            }
          }
        },
        {
          "name": "POST cria com override de bloqueio (clarify nº 5)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": {{paciente_id}},\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}},\n  \"starts_at\": \"{{slot_starts_at}}\",\n  \"channel_origin\": \"painel\",\n  \"override_block\": true,\n  \"override_motivo\": \"Encaixe de emergência\"\n}"
            },
            "description": "Exige ability `appointment.override_block` (default Admin Clínica). `motivo` obrigatório, audit `warning`, push notification ao profissional."
          }
        },
        {
          "name": "GET detalhe consulta",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas", "{{appointment_id}}"]
            }
          }
        },
        {
          "name": "POST reagenda consulta (clarify nº 7)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}/reagendar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas", "{{appointment_id}}", "reagendar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{$randomUUID}}\",\n  \"new_starts_at\": \"2026-06-16T10:00:00-03:00\",\n  \"motivo\": \"Paciente solicitou outro horário\",\n  \"quem_solicitou\": \"paciente\"\n}"
            },
            "description": "Mantém prof+tipo (não aceitos no payload). Limite 2 reagendamentos (3ª tentativa retorna 422 `reschedule_limit_exceeded` + escalated_to_inbox=true)."
          }
        }
      ]
    },
