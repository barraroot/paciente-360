          "name": "DELETE libera reserva (form fechado)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/agenda/slot-reservations/{{slot_reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["agenda", "slot-reservations", "{{slot_reservation_id}}"]
            }
          }
