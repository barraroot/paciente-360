          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}/marcar-comparecimento",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas", "{{appointment_id}}", "marcar-comparecimento"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
