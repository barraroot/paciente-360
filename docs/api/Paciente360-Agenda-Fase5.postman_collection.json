          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/agenda/appointment-types/{{appointment_type_id}}",
              "host": ["{{base_url}}"],
              "path": ["agenda", "appointment-types", "{{appointment_type_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "US-6.3 / 6.5 — Slots + Reservation",
      "description": "Consulta de slots disponíveis + reserva pessimista soft (clarify nº 2 — TTL 5min user / 2min IA).",
      "item": [
        {
          "name": "GET slots disponíveis (próximos 7d)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/slots-disponiveis?professional_id={{professional_id}}&appointment_type_id={{appointment_type_id}}&from=2026-06-15T00:00:00-03:00&to=2026-06-22T23:59:59-03:00",
              "host": ["{{base_url}}"],
              "path": ["agenda", "slots-disponiveis"],
              "query": [
                { "key": "professional_id", "value": "{{professional_id}}" },
                { "key": "appointment_type_id", "value": "{{appointment_type_id}}" },
                { "key": "from", "value": "2026-06-15T00:00:00-03:00" },
                { "key": "to", "value": "2026-06-22T23:59:59-03:00" }
              ]
            },
            "description": "Resposta inclui `timezone_display` (IANA) — clarify nº 13."
          }
        },
        {
          "name": "POST reserva slot (TTL 5min user)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/slots/{{slot_starts_at}}/reservar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "slots", "{{slot_starts_at}}", "reservar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}},\n  \"holder_type\": \"user\",\n  \"holder_id\": \"42\",\n  \"idempotency_key\": \"{{$randomUUID}}\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  pm.collectionVariables.set('slot_reservation_id', pm.response.json().data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "POST reserva slot (TTL 2min IA — clarify nº 2)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/slots/{{slot_starts_at}}/reservar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "slots", "{{slot_starts_at}}", "reservar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}},\n  \"holder_type\": \"ia\",\n  \"holder_id\": \"conv-abc-123\",\n  \"idempotency_key\": \"{{$randomUUID}}\"\n}"
            }
          }
        },
