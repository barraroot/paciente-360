            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quem_cancelou\": \"paciente\",\n  \"motivo\": \"Mudança de planos\"\n}"
            },
            "description": "Retorna 422 com `error=cancellation_outside_window`, `escalated_to_inbox=true`, `window_hours`, `current_hours_until_appt`. Emite evento `CancelamentoSolicitadoForaDoPrazo` para Fase 3 criar handoff."
          }
        },
        {
          "name": "POST cancela (profissional — irrestrito)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/consultas/{{appointment_id}}/cancelar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "consultas", "{{appointment_id}}", "cancelar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quem_cancelou\": \"profissional\",\n  \"motivo\": \"Emergência médica\"\n}"
            },
            "description": "Profissional/atendente irrestritos — motivo obrigatório + audit."
          }
        }
      ]
    },
    {
      "name": "US-6.6 — Lista de espera FIFO",
      "description": "FIFO sequencial K=1 (clarify nº 8 — 1 candidato notificado por vez, prazo 15min).",
      "item": [
        {
          "name": "GET lista entradas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/waitlist?professional_id={{professional_id}}&appointment_type_id={{appointment_type_id}}&status=waiting",
              "host": ["{{base_url}}"],
              "path": ["agenda", "waitlist"],
              "query": [
                { "key": "professional_id", "value": "{{professional_id}}" },
                { "key": "appointment_type_id", "value": "{{appointment_type_id}}" },
                { "key": "status", "value": "waiting" }
              ]
            }
          }
        },
        {
          "name": "POST inscreve paciente",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/waitlist",
              "host": ["{{base_url}}"],
              "path": ["agenda", "waitlist"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": {{paciente_id}},\n  \"professional_id\": {{professional_id}},\n  \"appointment_type_id\": {{appointment_type_id}}\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                    "  pm.collectionVariables.set('waitlist_id', pm.response.json().data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "DELETE remove entry",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/agenda/waitlist/{{waitlist_id}}",
              "host": ["{{base_url}}"],
              "path": ["agenda", "waitlist", "{{waitlist_id}}"]
            }
          }
        },
        {
          "name": "POST aceita vaga (status=notified)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/waitlist/{{waitlist_id}}/aceitar",
              "host": ["{{base_url}}"],
              "path": ["agenda", "waitlist", "{{waitlist_id}}", "aceitar"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{$randomUUID}}\"\n}"
            },
            "description": "Cria Appointment via channel_origin=autoatendimento. Erros: `waitlist_offer_expired` (15min sem confirmar) ou `waitlist_entry_not_notified`."
          }
        }
      ]
    },
    {
      "name": "US-6.7 — Calendar Sync (Google)",
      "description": "OAuth + sub-calendário tenant-scoped (clarify nº 15) + UX revogação (R5). Outlook DEFERRED → Fase 6.",
      "item": [
        {
          "name": "POST inicia OAuth Google (gera authorize_url)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/calendar-sync/google/connect",
              "host": ["{{base_url}}"],
              "path": ["agenda", "calendar-sync", "google", "connect"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_id\": {{professional_id}},\n  \"provider\": \"google\"\n}"
            },
            "description": "Resposta inclui `authorize_url` (redirecionar usuário) + `state` (CSRF). Provider=outlook retorna 422 `provider_not_yet_supported`."
          }
        },
        {
          "name": "GET callback OAuth (Google chama)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/calendar-sync/google/callback?code=AUTHORIZATION_CODE_FROM_GOOGLE&state=STATE_FROM_CONNECT&professional_id={{professional_id}}",
              "host": ["{{base_url}}"],
              "path": ["agenda", "calendar-sync", "google", "callback"],
              "query": [
                { "key": "code", "value": "AUTHORIZATION_CODE_FROM_GOOGLE" },
                { "key": "state", "value": "STATE_FROM_CONNECT" },
                { "key": "professional_id", "value": "{{professional_id}}" }
              ]
            },
            "description": "Troca code por token, cria sub-calendário `Paciente360 — {Tenant.nome}` (clarify nº 15), subscribe watch channel, retorna CalendarSyncAccount. Falha de criação → 422 `calendar_subcalendar_creation_failed`.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  pm.collectionVariables.set('calendar_sync_account_id', pm.response.json().data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "GET status do sync (do user logado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agenda/calendar-sync",
              "host": ["{{base_url}}"],
              "path": ["agenda", "calendar-sync"]
            }
          }
        },
        {
          "name": "POST desconecta (revoga + stop watch)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/agenda/calendar-sync/{{calendar_sync_account_id}}/disconnect",
              "host": ["{{base_url}}"],
              "path": ["agenda", "calendar-sync", "{{calendar_sync_account_id}}", "disconnect"]
            },
            "description": "Revoga token Google + stop watch channel. Eventos no Google permanecem (não deleta — clarify nº 10 / R5)."
          }
        }
      ]
    },
    {
      "name": "Webhooks — Google Calendar (público)",
      "description": "Recebe push notifications do Google. Validado por HMAC do header X-Goog-Channel-Token (R3). Sempre retorna 200.",
      "item": [
        {
          "name": "POST push notification do Google",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/../webhooks/google-calendar/CHANNEL_UUID_HERE",
              "host": ["{{base_url}}"],
              "path": ["..", "webhooks", "google-calendar", "CHANNEL_UUID_HERE"]
            },
            "header": [
              { "key": "X-Goog-Channel-Id", "value": "CHANNEL_UUID_HERE" },
              { "key": "X-Goog-Channel-Token", "value": "HMAC_SHA256_TOKEN" },
              { "key": "X-Goog-Resource-Id", "value": "RESOURCE_ID_FROM_WATCH" },
              { "key": "X-Goog-Resource-State", "value": "exists" },
              { "key": "X-Goog-Message-Number", "value": "1" }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.variables.set('skipAuth', true);"]
              }
            }
          ],
          "description": "Webhook PÚBLICO — sem Bearer/X-Tenant-Slug. HMAC token = hash_hmac('sha256', tenant_id.prof_id.channel_id, APP_KEY). Resource-State pode ser: sync (handshake), exists (mudança), not_exists (deleção)."
        }
      ]
    }
  ]
}
