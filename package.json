{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "widget:build": "vite build --config resources/widget/vite.config.widget.js",
        "lint": "prettier --check \"resources/{js,css}/**/*.{js,ts,vue,css}\"",
        "format": "prettier --write \"resources/{js,css}/**/*.{js,ts,vue,css}\"",
        "test:e2e": "playwright test --pass-with-no-tests"
    },
    "dependencies": {
        "@vueuse/core": "^12.0.0",
        "axios": "^1.7.9",
        "pinia": "^2.3.0",
        "vue": "^3.5.13",
        "vue-i18n": "^10.0.5",
        "vue-router": "^4.5.0",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "concurrently": "^9.0.1",
        "dompurify": "^3.4.2",
        "eslint-plugin-no-unsanitized": "^4.1.5",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.4.2",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
